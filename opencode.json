{
  "$schema": "https://opencode.ai/config.json",

  "default_agent": "developer",

  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": "ask",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch*": "allow",
      "npm test*": "allow",
      "npm run test*": "allow"
    }
  }
}